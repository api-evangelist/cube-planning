        },
        {
          "info": {
            "name": "Retrieve a cube value range with A1 headers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cubesoftware.com/ranges/:id/a1",
            "headers": [
              {
                "name": "X-Company-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
