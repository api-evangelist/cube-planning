              "authorizationUrl": "https://portal.cubesoftware.com/o/authorize/",
              "accessTokenUrl": "https://api.cubesoftware.com/o/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Perform a full update of an existing cube value range.\n\n- Read-only fields (`id`, `headers`) will be ignored if included.\n- The `headers` field is not accepted in the request but will appear in the response."
        },
