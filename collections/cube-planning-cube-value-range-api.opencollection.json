              "accessTokenUrl": "https://api.cubesoftware.com/o/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Update one or more editable fields on an existing cube value range.\n\n"
        },
        {
          "info": {
            "name": "Delete a cube value range",
            "type": "http"
