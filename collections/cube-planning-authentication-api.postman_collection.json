      "name": "Authentication",
      "description": {
        "content": "The Cube API supports user authentication via OAuth2 using the OAuth2 Authorization Code Flow.\n            To authenticate via OAuth2, an application must first be registered.\n        ",
        "type": "text/plain"
      },
