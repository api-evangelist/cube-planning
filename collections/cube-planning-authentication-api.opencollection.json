{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cube Agents Authentication API",
    "version": "1.0.0 (1.0)"
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get an Access Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cubesoftware.com/auth/access_token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Do not use this endpoint, use the standard OAuth 2.0 PKCE flow instead"
        },
        {
          "info": {
            "name": "Retrieve a Permission Group",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cubesoftware.com/auth/permissions/:group_id",
            "headers": [
              {
                "name": "X-Company-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "group_id",
                "value": "",
                "type": "path",
                "description": "The ID of the permissions group"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://portal.cubesoftware.com/o/authorize/",
              "accessTokenUrl": "https://api.cubesoftware.com/o/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves details for a given permissions group"
        }
      ]
    }
  ],
  "bundled": true
}